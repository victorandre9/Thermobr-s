# ---------------------------------------------------------------------------
# Thermobrás — variáveis de ambiente (EXEMPLO, sem segredos)
# Copie para .env.local em desenvolvimento. Na Vercel, cadastre em Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Ambiente lógico: development | homologacao | production
# Dados/contas de demonstração só podem ser criados quando APP_ENV != production.
APP_ENV=development

# PostgreSQL (Neon). Use a URL "pooled" (pgbouncer) para a aplicação na Vercel.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thermobras_dev
# URL direta (sem pooler) para rodar migrações, se diferente.
DATABASE_URL_UNPOOLED=

# Exigir SSL na conexão (Neon exige). Em local, deixe vazio.
DATABASE_SSL=

# URL pública da aplicação (usada em links de redefinição de senha e verificação de origem)
APP_URL=http://localhost:3000

# Armazenamento privado de anexos: "local" (somente dev) | "s3" (S3 compatível: AWS S3, Cloudflare R2...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Integração Treeunfe (pedidos) — AGUARDANDO VALIDAÇÃO. Não preencher sem documentação oficial de API de pedidos.
TREEUNFE_API_BASE_URL=
TREEUNFE_API_TOKEN=
TREEUNFE_WEBHOOK_SECRET=

# Segredo para rotas de rotina agendada (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
